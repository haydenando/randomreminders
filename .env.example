# Reminder bot token (from @BotFather, the public bot users talk to)
BOT_TOKEN=

# Vault bot token (from @BotFather, a second bot that owns the hidden data message)
VAULT_TOKEN=

# Numeric chat id of the private chat between YOU and the VAULT bot.
# Get it: message your vault bot, then open
#   https://api.telegram.org/bot<VAULT_TOKEN>/getUpdates
# and look for "chat":{"id": <NUMBER>} in the response.
VAULT_CHAT_ID=

# Secret phrase the user must type after /start to unlock the bot.
SECRET_PHRASE=haydenando

# Optional: your timezone for "specific time" schedules (IANA name).
# e.g. Europe/Amsterdam, America/New_York, Asia/Tokyo
DEFAULT_TIMEZONE=UTC

# Your Render deploy URL (used by /miniapp to build the web app link).
# e.g. https://randomreminders.onrender.com
MINI_APP_URL=

